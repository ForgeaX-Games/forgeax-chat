{
	"packageManager": "bun@1.4.0",
	"name": "@forgeax/chat",
	"version": "0.1.0",
	"private": false,
	"license": "Apache-2.0",
	"type": "module",
	"description": "ForgeaX independent chat app \u2014 the Forge conversation surface, composer, message rendering, and chat/session ownership.",
	"repository": {
		"type": "git",
		"url": "https://github.com/ForgeaX-Games/forgeax-chat.git"
	},
	"homepage": "https://github.com/ForgeaX-Games/forgeax-chat",
	"exports": {
		".": "./src/index.ts",
		"./runtime": "./src/runtime.tsx",
		"./event-engine/*": "./src/event-engine/*.ts",
		"./session-store": "./src/session-store/index.ts",
		"./*": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "bun run lint:types && bun run lint:biome",
		"forgeax-extension": "bun scripts/forgeax-extension.ts",
		"lint:types": "tsc --noEmit -p tsconfig.json",
		"lint:biome": "biome check --config-path=biome.json . --diagnostic-level=error",
		"lint:fix": "biome check --config-path=biome.json --write .",
		"lint:staged": "lint-staged",
		"hooks:install": "lefthook install"
	},
	"dependencies": {
		"@forgeax/design": "0.1.0",
		"@forgeax/agents": "0.1.0",
		"@forgeax/types": "^0.1.2",
		"@radix-ui/react-popover": "^1.1.20",
		"lucide-react": "^0.460.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-markdown": "^10.1.0",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^6.0.3",
		"typescript": "^5.6.3",
		"vite": "^8.0.0",
		"@biomejs/biome": "2.5.13",
		"lefthook": "2.1.14",
		"lint-staged": "16.4.0",
		"happy-dom": "^20.14.5",
		"vite-plugin-checker": "0.14.5"
	},
	"lint-staged": {
		"*": "biome check --config-path=biome.json --write --no-errors-on-unmatched --files-ignore-unknown=true"
	}
}
